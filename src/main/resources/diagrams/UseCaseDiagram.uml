@startuml
left to right direction

skinparam usecase {
  BackgroundColor LightYellow
  BorderColor Black
  FontSize 14
}
skinparam actor {
  BackgroundColor LightBlue
  BorderColor Black
  FontSize 14
}

actor :Administrador: as ADM
actor :ProfissionalDaSaude: as PRO
actor :Atendente: as ATD
actor :Paciente: as PAC

package "Autenticação" {
    usecase "Login" as UC_LOGIN
    usecase "Logout" as UC_LOGOUT
    usecase "Renovar Token" as UC_RENOVAR
}

package "Governança e Acesso" {
    usecase "Provisionar Usuário" as UC_PROVISIONAR << (R,#FFAAAA) >>
    usecase "Gerenciar Perfis e Permissões" as UC_PERFIS
    usecase "Bloquear/Desbloquear Conta" as UC_BLOQUEAR
}

package "Suporte ao Paciente" {
    usecase "Cadastrar Paciente" as UC_CADASTRAR << (R,#FFAAAA) >>
    usecase "Atualizar Dados Cadastrais" as UC_ATUALIZAR
    usecase "Liberar Acesso do Paciente" as UC_LIBERAR
}

package "Atendimento Clínico" {
    usecase "Registrar Atendimento" as UC_ATENDIMENTO
    usecase "Manter Prontuário" as UC_PRONTUARIO
    usecase "Emitir Receituário" as UC_RECEITA
    usecase "Revisar Histórico do Paciente" as UC_HISTORICO
}

package "Autoatendimento do Paciente" {
    usecase "Consultar Prontuário" as UC_CONSULTAR_PRONTUARIO
    usecase "Consultar Receituários" as UC_CONSULTAR_RECEITA
}

ADM --> UC_LOGIN
PRO --> UC_LOGIN
ATD --> UC_LOGIN
PAC --> UC_LOGIN

ADM --> UC_PROVISIONAR
ADM --> UC_PERFIS
ADM --> UC_BLOQUEAR

ATD --> UC_CADASTRAR
ATD --> UC_ATUALIZAR
ATD --> UC_LIBERAR

PRO --> UC_ATENDIMENTO
PRO --> UC_PRONTUARIO
PRO --> UC_RECEITA
PRO --> UC_HISTORICO

PAC --> UC_CONSULTAR_PRONTUARIO
PAC --> UC_CONSULTAR_RECEITA

UC_ATENDIMENTO ..> UC_LOGIN : <<include>>
UC_PRONTUARIO ..> UC_LOGIN : <<include>>
UC_RECEITA ..> UC_LOGIN : <<include>>
UC_HISTORICO ..> UC_LOGIN : <<include>>
UC_CONSULTAR_PRONTUARIO ..> UC_LOGIN : <<include>>
UC_CONSULTAR_RECEITA ..> UC_LOGIN : <<include>>

UC_ATENDIMENTO ..> UC_PRONTUARIO : <<include>>
UC_RECEITA ..> UC_ATENDIMENTO : <<extend>>
UC_PROVISIONAR ..> UC_PERFIS : <<include>>
UC_LIBERAR ..> UC_CADASTRAR : <<extend>>

ADM --> UC_LOGOUT
PRO --> UC_LOGOUT
ATD --> UC_LOGOUT
PAC --> UC_LOGOUT

ADM --> UC_RENOVAR
PRO --> UC_RENOVAR
ATD --> UC_RENOVAR
PAC --> UC_RENOVAR

@enduml
